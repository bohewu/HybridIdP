<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HybridAuth demo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestClient.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="border-bottom bg-white">
        <nav class="navbar navbar-expand-md py-3" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">HybridAuth <span class="text-secondary fw-normal">/ demo</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#demo-navigation" aria-controls="demo-navigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="demo-navigation">
                    <ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Demo center</a></li><li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Profile">Session</a></li><li class="nav-item"><a class="nav-link" href="/#other-samples">Other samples</a></li></ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    { <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button></form> }
                    else
                    { <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Sign in</a> }
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4 flex-grow-1" id="main-content">@RenderBody()</main>
    <footer class="demo-footer border-top"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>HybridAuth IdP sample client</span><span>Local development demonstration <a class="ms-3" asp-controller="Home" asp-action="Privacy">Privacy</a></span></div></footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
