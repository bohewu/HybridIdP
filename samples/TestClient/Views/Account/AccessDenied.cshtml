@{ ViewData["Title"] = "Consent declined"; }
<section class="demo-panel mx-auto mt-4 demo-result-panel">
    <div class="demo-eyebrow">Consent result</div><h1 class="mt-2">Access was declined.</h1>
    <p class="mt-3">The IdP returned access_denied. This sign-in did not issue a new client session.</p>
    <p>You can return to the demo center or start sign-in again to review the requested access.</p>
    <div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to demo center</a><a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Try sign-in again</a></div>
</section>
