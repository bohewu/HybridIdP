@{
    ViewData["Title"] = "Sign-in result";
    var code = ViewData["ErrorMessage"]?.ToString() ?? "authentication_failed";
    var explanation = code switch
    {
        "invalid_scope" => "The requested scope is not registered or allowed for this client. This is the expected result of the invalid-scope demo.",
        "login_required" => "Silent sign-in needs an authenticated IdP session. Start standard sign-in and then try again.",
        "consent_required" => "Silent sign-in cannot show consent. Approve access with an interactive request first.",
        "interaction_required" => "The IdP needs user interaction, such as MFA. Continue with an interactive sign-in.",
        "invalid_request" => "The IdP rejected the authorization request. Check the registered client and its request settings.",
        "server_error" => "The IdP could not complete the request. Check its availability before signing in again.",
        _ => "Sign-in could not complete. Check the IdP connection and try an interactive sign-in."
    };
}
<section class="demo-panel mx-auto mt-4 demo-result-panel">
    <div class="demo-eyebrow">Protocol response</div><h1 class="mt-2">Sign-in needs attention.</h1>
    <div class="alert alert-warning mt-4" role="alert"><strong>@code</strong><p class="mb-0 mt-2">@explanation</p></div>
    <div class="d-flex flex-wrap gap-2 mt-4"><a class="btn btn-primary" asp-controller="Account" asp-action="Login">Start standard sign-in</a><a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to demo center</a></div>
</section>
