@model ApiDemoViewModel
@{ ViewData["Title"] = Model.Operation; }
<div class="section-heading mt-4"><div><div class="demo-eyebrow">OIDC endpoint</div><h1>@Model.Operation</h1><p>Inspect the result of the request sent by this client.</p></div></div>
<div class="alert @(Model.Success ? "alert-success" : "alert-danger")" role="alert" data-testid="api-result">
    <h2 class="h4">@(Model.ExpectedProtocolError is not null ? "Expected protocol error" : Model.Success ? "Request successful" : "Request could not complete")</h2>
    <p class="mb-1">@Model.Message</p>
    @if (Model.StatusCode.HasValue) { <span>HTTP @Model.StatusCode</span> }
    @if (Model.ExpectedProtocolError is not null) { <p class="mt-2 mb-0"><code>@Model.ExpectedProtocolError</code></p> }
    @if (Model.RefreshTokenRotated.HasValue) { <p class="mb-0 mt-2">Refresh token rotated: @(Model.RefreshTokenRotated.Value ? "Yes" : "No replacement issued")</p> }
</div>
@if (Model.UserInfoJson is not null) { <section class="demo-panel mt-4"><h2>UserInfo response</h2><pre class="userinfo-json mb-0">@Model.UserInfoJson</pre></section> }
<div class="d-flex flex-wrap gap-3 mt-4">
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to demo center</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-outline-primary" asp-action="Profile">Back to session</a>
        <a class="btn btn-outline-primary" asp-action="TestApiCall">Call UserInfo again</a>
        <form asp-action="RefreshUserInfo" method="post"><button class="btn btn-outline-primary" type="submit">Refresh tokens + UserInfo</button></form>
    }
    <a class="btn btn-outline-secondary" asp-action="Login" asp-route-scenario="fresh">Sign in again</a>
</div>
