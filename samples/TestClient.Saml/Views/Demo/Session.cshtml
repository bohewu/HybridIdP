@{ ViewData["Title"] = "Consumer session"; }
<section class="panel result"><span class="eyebrow">Consumer result</span><h1>@(User.Identity?.IsAuthenticated == true ? "Identity validated" : "No active consumer session")</h1>
@if (User.Identity?.IsAuthenticated == true)
{
    <p>The response and assertion signatures, pinned issuer, audience, recipient, request correlation and lifetime passed validation.</p>
    <dl><dt>Trusted identity provider</dt><dd>@User.FindFirstValue("validated_issuer")</dd><dt>Persistent subject</dt><dd>@User.FindFirstValue(ClaimTypes.NameIdentifier)</dd><dt>Validated at (UTC)</dt><dd>@User.FindFirstValue("validated_at")</dd><dt>Session scope</dt><dd>This sample app only</dd></dl>
    <form action="/logout" method="post">@Html.AntiForgeryToken()<button type="submit">Sign out of this sample</button></form><p class="hint">Local sign-out clears this session. Your HybridIdP session may remain active.</p>
}
else { <p>Start a new sign-in from the demo center to see a validated identity here.</p><a class="button" href="/">Go to demo center</a> }
</section>
