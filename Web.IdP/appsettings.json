{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "SqlServer",
  "Branding": {
    "AppName": "HybridAuth",
    "ProductName": "HybridAuth IdP",
    "Copyright": "© 2025 - HybridAuth IdP",
    "PoweredBy": ""
  },
  "Cookies": {
    "Prefix": ".IdP"
  },
  "TokenOptions": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 20160,
    "DeviceCodeLifetimeMinutes": 15,
    "RefreshTokenReuseLeewaySeconds": 60
  },
  "Turnstile": {
    "Enabled": false,
    "SiteKey": "",
    "SecretKey": ""
  },
  "Fido2": {
    "ServerDomain": "localhost",
    "Origins": [
      "https://localhost:7035"
    ],
    "TimestampDriftTolerance": 300000
  },
  "ExternalLogin": {
    "MaxLoginsPerProvider": 2,
    "ForceAccountSelection": true,
    "Google": {
      "HostedDomain": ""
    },
    "Microsoft": {
    }
  },
  "Observability": {
    "Enabled": false,
    "PrometheusEnabled": true,
    "AllowedIPs": [
      "127.0.0.1",
      "::1"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "TokenPermitLimit": 10,
    "TokenWindowSeconds": 60,
    "AuthorizePermitLimit": 30,
    "AuthorizeWindowSeconds": 60,
    "AdminApiPermitLimit": 100,
    "AdminApiWindowSeconds": 60,
    "QueueLimit": 2
  },
  "RedirectUriSecurityPolicy": {
    "EnforceHttps": true,
    "AllowLocalhostHttp": true,
    "AllowedHosts": []
  },
  "Audit": {
    "PiiMaskingLevel": "Partial"
  },
  "Redis": {
    "Enabled": false,
    "InstanceName": "HybridIdP_"
  },
  "Vite": {
    "Manifest": "dist/.vite/manifest.json"
  },
  "LayoutAssets": {
    "ExternalCssLinks": [],
    "ExternalJsLinks": [],
    "ExternalScriptTags": []
  },
  "SecurityHeaders": {
    "Csp": {
      "ScriptSrc": [],
      "ScriptSrcElem": [],
      "StyleSrc": [],
      "StyleSrcElem": [],
      "FontSrc": [],
      "FontSrcElem": [],
      "ConnectSrc": [],
      "FrameSrc": [],
      "AdditionalDirectives": []
    }
  }
}
