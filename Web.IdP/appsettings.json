{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost",
  "DatabaseProvider": "SqlServer",
  "DatabaseMigration": {
    "ApplyOnStartup": true
  },
  "Branding": {
    "AppName": "HybridAuth",
    "ProductName": "HybridAuth IdP",
    "Copyright": "© 2025 - HybridAuth IdP",
    "PoweredBy": ""
  },
  "Cookies": {
    "Prefix": ".IdP"
  },
  "TokenOptions": {
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeMinutes": 20160,
    "DeviceCodeLifetimeMinutes": 15,
    "RefreshTokenReuseLeewaySeconds": 60
  },
  "Turnstile": {
    "Enabled": false,
    "SiteKey": "",
    "SecretKey": ""
  },
  "Fido2": {
    "ServerDomain": "localhost",
    "Origins": [
      "https://localhost:7035"
    ],
    "TimestampDriftTolerance": 300000
  },
  "ExternalLogin": {
    "MaxLoginsPerProvider": 2,
    "ForceAccountSelection": true,
    "AutoProvisionDefaultRole": "User",
    "Google": {
      "HostedDomain": ""
    },
    "Microsoft": {
    }
  },
  "PrivilegedRoleProtection": {
    "RequireOperatorMfaForPrivilegedRoleAssignment": false,
    "RequireTargetMfaForPrivilegedRoleAssignment": false,
    "CountPasskeyAsMfa": true,
    "ProtectedRoles": [
      "Admin",
      "ApplicationManager"
    ]
  },
  "ClientAdminApiHardening": {
    "DisableClientWriteEndpoints": false
  },
  "Observability": {
    "Enabled": false,
    "PrometheusEnabled": true,
    "AllowedIPs": [
      "127.0.0.1",
      "::1"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "TokenPermitLimit": 10,
    "TokenWindowSeconds": 60,
    "AuthorizePermitLimit": 30,
    "AuthorizeWindowSeconds": 60,
    "AdminApiPermitLimit": 100,
    "AdminApiWindowSeconds": 60,
    "QueueLimit": 2
  },
  "RedirectUriSecurityPolicy": {
    "EnforceHttps": true,
    "AllowLocalhostHttp": true,
    "AllowedHosts": []
  },
  "DirectoryIntegration": {
    "Enabled": false,
    "AuthenticationEnabled": false,
    "Transport": "Ldaps"
  },
  "ProviderMetadataRefresh": {
    "Enabled": false,
    "AllowPrivateNetworkHttp": false,
    "Timeout": "00:00:05"
  },
  "LegacyPasswordSync": {
    "Enabled": false,
    "CompletedDirectoryRecoveryEnabled": false,
    "CompletedDirectoryRequiredChangeEnabled": false,
    "Stage2MigrationEnabled": false,
    "AllowPrivateNetworkHttp": false,
    "Timeout": "00:00:05",
    "Mappings": []
  },
  "RecoveryVerificationPolicy": {
    "Enabled": false,
    "BootstrapEnabled": false,
    "AcceptSourceVerifiedEmails": false,
    "AcceptPolicyTrustedEmails": false
  },
  "ForgotPasswordRecovery": {
    "TopNotice": "",
    "VerificationTip": "",
    "ResetTip": "",
    "SuccessReminder": "",
    "SupportText": "",
    "SupportLabel": "",
    "SupportUrl": "",
    "DeploymentCeiling": "External",
    "NativeRecoveryEnabled": false,
    "NativeDirectoryRecoveryEnabled": false,
    "PendingDirectorySettlementEnabled": false,
    "NativeOtpLifetimeMinutes": 10,
    "NativeOtpMaxAttempts": 5,
    "NativeOtpResendCooldownSeconds": 60
  },
  "CredentialMigration": {
    "Enabled": false,
    "EmailOtpPolicyFloor": "Disabled",
    "OperatorCutoff": false,
    "RecoveryEmailEnabled": false,
    "MigrationEmailOtpEnabled": false,
    "RecoveryAdminAssistanceEnabled": false,
    "RecoveryOtpLifetimeMinutes": 10,
    "RecoveryOtpMaxAttempts": 5,
    "RecoveryOtpResendCooldownSeconds": 60,
    "RecoveryApprovalLifetimeMinutes": 10
  },
  "Audit": {
    "PiiMaskingLevel": "Partial"
  },
  "Redis": {
    "Enabled": false,
    "InstanceName": "HybridIdP_"
  },
  "Vite": {
    "Manifest": "dist/.vite/manifest.json"
  },
  "LayoutAssets": {
    "ExternalCssLinks": [],
    "ExternalJsLinks": [],
    "ExternalScriptTags": []
  },
  "SecurityHeaders": {
    "Csp": {
      "ScriptSrc": [],
      "ScriptSrcElem": [],
      "StyleSrc": [],
      "StyleSrcElem": [],
      "FontSrc": [],
      "FontSrcElem": [],
      "ConnectSrc": [],
      "FrameSrc": [],
      "AdditionalDirectives": []
    }
  }
}
