@using Core.Domain.Constants
@using Web.IdP.Helpers
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web.IdP.SharedResource> Localizer

@if (User?.IsInRole(AuthConstants.Roles.Admin) == true)
{
    <details class="static md:relative" data-test-id="system-info">
        <summary class="flex cursor-pointer list-none items-center rounded text-gray-500 hover:text-gray-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-600 [&::-webkit-details-marker]:hidden"
                 aria-label="@Localizer["AdminSystemInfo.Title"]">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 11v6m0-10h.01" />
            </svg>
        </summary>
        <div class="absolute bottom-full left-1/2 z-50 mb-3 w-60 max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-lg border border-gray-200 bg-white p-4 text-left text-sm text-gray-700 shadow-lg md:left-auto md:right-0 md:translate-x-0">
            <p class="mb-2 font-semibold">@Localizer["AdminSystemInfo.Title"]</p>
            <p class="mb-2">@Localizer["AdminSystemInfo.BasedOn"]</p>
            <dl class="flex items-baseline justify-between gap-4">
                <dt class="text-gray-500">@Localizer["AdminSystemInfo.Version"]</dt>
                <dd class="m-0 font-mono" data-test-id="system-version">@(ProductVersionInfo.Version ?? Localizer["AdminSystemInfo.VersionUnavailable"].Value)</dd>
            </dl>
        </div>
    </details>
}
