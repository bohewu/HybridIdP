@page
@model WelcomeModel
@using Microsoft.Extensions.Localization
@using Core.Domain.Constants
@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject Web.IdP.Services.IViteManifestService ViteService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Localizer["WelcomeTo"] + " " + Model.ProductName;
    Layout = null;
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "zh-TW";
    var csrfToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
    var preferredUsername = User?.FindFirst(AuthConstants.Claims.PreferredUsername)?.Value;
    var displayName = User?.Identity?.Name ?? preferredUsername ?? "User";
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="locale" content="@currentCulture" />
    <meta name="csrf-token" content="@csrfToken" />
    <meta name="google-site-verification" content="lUzaCoBBccLoZCGY3WWSSiYvhuubfc408MtOl1f-7QU" />
    <title>@ViewData["Title"]</title>
    
    @* Tailwind CSS *@
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    
    @* Google Fonts - Roboto *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body class="h-full google-font">
    <div class="min-h-full flex flex-col">
        <!-- Header with Language Selector -->
        <header class="bg-white border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex justify-between items-center">
                    <div class="flex items-center">
                        <h1 class="text-xl font-medium text-gray-900">@Model.ProductName</h1>
                    </div>
                    <div class="flex items-center space-x-4">
                        <select class="language-select bg-transparent border border-gray-300 rounded-md px-3 py-1.5 text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" aria-label="@Localizer["Language"]">
                            <option value="zh-TW" selected="@(currentCulture == "zh-TW")">繁體中文</option>
                            <option value="en-US" selected="@(currentCulture == "en-US")">English</option>
                        </select>
                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <span class="text-sm text-gray-700 hidden sm:inline">@Localizer["Welcome"], @displayName</span>
                            <a href="/Dashboard" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                @Localizer["Dashboard"]
                            </a>
                        }
                        else
                        {
                            <a href="/Account/Login" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                @Localizer["SignIn"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-1">
            <!-- Hero Section -->
            <div class="bg-gradient-to-br from-blue-50 to-indigo-100 py-16 sm:py-24">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center">
                        <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-6">
                            @Localizer["WelcomePageTitle"]
                        </h1>
                        <p class="text-xl text-gray-700 mb-8 max-w-3xl mx-auto">
                            @Localizer["WelcomePageDescription"]
                        </p>
                        @if (User?.Identity?.IsAuthenticated != true)
                        {
                            <div class="flex justify-center gap-4">
                                <a href="/Account/Login" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                    @Localizer["SignIn"]
                                </a>
                                @if (Model.RegistrationEnabled)
                                {
                                    <a href="/Account/Register" class="inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                                        @Localizer["Register"]
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="py-16 bg-white">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl font-bold text-gray-900 mb-4">@Localizer["WelcomePageFeaturesTitle"]</h2>
                        <p class="text-lg text-gray-600">@Localizer["WelcomePageFeaturesSubtitle"]</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <!-- Feature 1: Single Sign-On -->
                        <div class="text-center">
                            <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center mx-auto mb-4">
                                <i class="bi bi-key text-blue-600 text-3xl"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">@Localizer["FeatureSSOTitle"]</h3>
                            <p class="text-gray-600">@Localizer["FeatureSSODescription"]</p>
                        </div>

                        <!-- Feature 2: Multiple Authentication Methods -->
                        <div class="text-center">
                            <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-4">
                                <i class="bi bi-shield-check text-green-600 text-3xl"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">@Localizer["FeatureMultiAuthTitle"]</h3>
                            <p class="text-gray-600">@Localizer["FeatureMultiAuthDescription"]</p>
                        </div>

                        <!-- Feature 3: Secure & Compliant -->
                        <div class="text-center">
                            <div class="w-16 h-16 rounded-full bg-purple-100 flex items-center justify-center mx-auto mb-4">
                                <i class="bi bi-lock text-purple-600 text-3xl"></i>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">@Localizer["FeatureSecureTitle"]</h3>
                            <p class="text-gray-600">@Localizer["FeatureSecureDescription"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Authentication Methods -->
            <div class="py-16 bg-gray-50">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="text-center mb-12">
                        <h2 class="text-3xl font-bold text-gray-900 mb-4">@Localizer["SupportedAuthMethods"]</h2>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                            <i class="bi bi-person-circle text-4xl text-gray-700 mb-2"></i>
                            <p class="text-sm font-medium text-gray-900">@Localizer["LocalAccount"]</p>
                        </div>
                        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center flex flex-col items-center justify-center">
                            <img src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png" 
                                 class="h-10 w-10 mb-2" 
                                 alt="Google" />
                            <p class="text-sm font-medium text-gray-900">Google</p>
                        </div>
                        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                            <i class="bi bi-shield-lock text-4xl text-green-600 mb-2"></i>
                            <p class="text-sm font-medium text-gray-900">TOTP</p>
                        </div>
                        <div class="bg-white p-6 rounded-lg border border-gray-200 text-center">
                            <i class="bi bi-fingerprint text-4xl text-blue-600 mb-2"></i>
                            <p class="text-sm font-medium text-gray-900">@Localizer["Passkey"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 py-8">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
                    <div class="text-center md:text-left">
                        <p class="text-sm text-gray-600">@Model.CopyrightText</p>
                    </div>
                    <div class="flex space-x-6">
                        <a href="/Privacy" class="text-sm text-gray-600 hover:text-gray-900">@Localizer["PrivacyPolicy"]</a>
                        <a href="/Docs" class="text-sm text-gray-600 hover:text-gray-900">@Localizer["Documentation"]</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</body>
</html>
