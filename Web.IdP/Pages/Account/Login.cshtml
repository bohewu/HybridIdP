@page
@model Web.IdP.Pages.Account.LoginModel
@using Web.IdP.TagHelpers
@using Web.IdP.Services
@using Web.IdP.Options
@using Core.Application
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject IViteManifestService ViteService
@inject IBrandingService BrandingService
@inject IOptions<LoginNoticesOptions> LoginNoticesOptions
@{
    ViewData["Title"] = Localizer["Login"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
    var productName = await BrandingService.GetProductNameAsync();
    var notices = LoginNoticesOptions.Value;
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @productName</title>
    
    @* Tailwind CSS *@
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    
    @* Google Fonts - Roboto for body, will fallback gracefully *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <div class="google-login-container">
        @* Top Notice - Above the card *@
        @if (!string.IsNullOrWhiteSpace(notices.TopMessage))
        {
            <div class="w-full max-w-md mx-auto mb-4">
                <partial name="_LoginNotice" model="(notices.TopMessage, notices.TopType)" />
            </div>
        }
        
        <div class="google-login-card">
            <div class="google-login-header text-center">
                 <div class="flex justify-center mb-4">
                    <div class="google-logo">
                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                </div>
                <h1 class="text-2xl font-normal text-gray-900 mb-2">@productName</h1>
                <h2 class="text-lg text-gray-700 font-normal">@Localizer["Login"]</h2>
                <p class="mt-1 text-sm text-gray-500">@Localizer["SignInToContinue"]</p>
            </div>
            
            <div class="google-login-body">
                @if (Model.ExternalLogins?.Count > 0)
                {
                    <div class="mb-6">
                        <form id="external-account" asp-page-handler="ExternalLogin" method="post" class="space-y-3">
                            <div class="grid grid-cols-1 gap-3">
                                @foreach (var provider in Model.ExternalLogins)
                                {
                                    <button type="submit" class="w-full flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200" name="provider" value="@provider.Name" title="@Localizer["LogInWith", provider.DisplayName ?? provider.Name]">
                                        @if (provider.Name == "Google")
                                        {
                                            <svg class="h-5 w-5 mr-2" viewBox="0 0 24 24" fill="currentColor">
                                                <path d="M12.545,10.239v3.821h5.445c-0.712,2.315-2.647,3.972-5.445,3.972c-3.332,0-6.033-2.701-6.033-6.032s2.701-6.032,6.033-6.032c1.498,0,2.866,0.549,3.921,1.453l2.814-2.814C17.503,2.988,15.139,2,12.545,2C7.021,2,2.543,6.477,2.543,12s4.478,10,10.002,10c8.396,0,10.249-7.85,9.426-11.748L12.545,10.239z" />
                                            </svg>
                                        }
                                        else if (provider.Name == "Microsoft")
                                        {
                                            <svg class="h-5 w-5 mr-2" viewBox="0 0 23 23" fill="currentColor">
                                                <path fill="#f3f3f3" d="M0 0h23v23H0z"/><path fill="#f35325" d="M1 1h10v10H1z"/><path fill="#81bc06" d="M12 1h10v10H12z"/><path fill="#05a6f0" d="M1 12h10v10H1z"/><path fill="#ffba08" d="M12 12h10v10H12z"/>
                                            </svg>
                                        }
                                        <span>@Localizer["LogInWith", provider.DisplayName ?? provider.Name]</span>
                                    </button>
                                }
                            </div>
                        </form>
                        
                        <div class="relative flex py-2 items-center">
                            <div class="flex-grow border-t border-gray-300"></div>
                            <span class="flex-shrink-0 mx-4 text-gray-400 text-xs uppercase">@Localizer["Or"]</span>
                            <div class="flex-grow border-t border-gray-300"></div>
                        </div>
                    </div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-700 p-3 rounded text-sm border border-red-200 mb-6" role="alert" data-test-id="login-error-summary"></div>
                    
                    @if (!string.IsNullOrWhiteSpace(notices.FormMessage))
                    {
                        <div class="mb-4">
                            <partial name="_LoginNotice" model="(notices.FormMessage, notices.FormType)" />
                        </div>
                    }
                    
                    <input type="hidden" asp-for="ReturnUrl" />
                    
                    <div class="space-y-4">
                        <div class="form-group">
                            <label asp-for="Input.Login" class="sr-only">@Localizer["EmailOrUsername"]</label>
                            <input asp-for="Input.Login" class="input-google" placeholder="@Localizer["EmailOrUsername"]" autocomplete="username webauthn" autofocus data-test-id="login-username" />
                            <span asp-validation-for="Input.Login" class="text-red-600 text-xs mt-1 block" data-test-id="login-username-error"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Input.Password" class="sr-only">@Localizer["Password"]</label>
                            <input asp-for="Input.Password" type="password" class="input-google" placeholder="@Localizer["Password"]" autocomplete="current-password" data-test-id="login-password" />
                            <span asp-validation-for="Input.Password" class="text-red-600 text-xs mt-1 block" data-test-id="login-password-error"></span>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.CustomForgotPasswordUrl))
                        {
                            <div class="text-right">
                                <a href="@Model.CustomForgotPasswordUrl" target="_blank" rel="noopener noreferrer" class="text-sm link-google" data-test-id="forgot-password-link">
                                    @Localizer["ForgotPassword"]
                                </a>
                            </div>
                        }
                    </div>
                
                    @if (Model.TurnstileEnabled)
                    {
                        <div class="my-6 flex justify-center">
                            <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-callback="onTurnstileSuccess" data-expired-callback="onTurnstileExpired"></div>
                        </div>
                    }
                    
                    <div class="flex items-center justify-between mt-8">
                        @if (Model.RegistrationEnabled)
                        {
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-google text-sm font-medium">
                                @Localizer["CreateAccount"]
                            </a>
                        }
                        else 
                        {
                            <div></div> <!-- Spacer -->
                        }

                        <div class="flex space-x-2">
                             @if (Model.PasskeyEnabled)
                             {
                                <button type="button" 
                                        id="passkeyLoginBtn"
                                        title="@Localizer["LoginWithPasskey"]"
                                        class="btn-google-outline p-2 flex items-center justify-center"
                                        data-test-id="passkey-login-btn"
                                        data-return-url="@(Model.ReturnUrl ?? Url.Content("~/"))"
                                        data-error-no-passkeys="@Localizer["mfa.errors.noPasskeysRegistered"]"
                                        data-error-not-found="@Localizer["mfa.errors.passkeyNotRegistered"]">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                                    </svg>
                                </button>
                             }

                            <button type="submit" 
                                    class="btn-google-blue" 
                                    data-test-id="login-submit"
                                    id="loginSubmitBtn">
                                @Localizer["Login"]
                            </button>
                        </div>
                    </div>
                    
                    @* Bottom Notice - After submit button *@
                    @if (!string.IsNullOrWhiteSpace(notices.BottomMessage))
                    {
                        <div class="mt-6">
                            <partial name="_LoginNotice" model="(notices.BottomMessage, notices.BottomType)" />
                        </div>
                    }
                </form>
            </div>
        </div>
        
        <partial name="_GoogleFooter" />
    </div>

    @if (Model.TurnstileEnabled)
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
    }
</body>
</html>
