@page
@model Web.IdP.Pages.Account.LoginMfaModel
@using Web.IdP.Services
@using Core.Application
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject IViteManifestService ViteService
@inject IBrandingService BrandingService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Localizer[Model.IsRecoveryOnly ? "RecoverVerificationMethod" : "ChooseVerificationMethod"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
    var productName = await BrandingService.GetProductNameAsync();
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @productName</title>
    <script async src="~/js/account-form-guard.js" asp-append-version="true"></script>
    
    @* Tailwind CSS *@
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    
    @* Google Fonts - Roboto for body *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <div class="google-login-container">
        <div class="google-login-card">
            <div class="google-login-header text-center">
                <div class="flex justify-center mb-4">
                    <div class="google-logo">
                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                    </div>
                </div>
                <h1 class="text-2xl font-normal text-gray-900 mb-2">@ViewData["Title"]</h1>
                <p class="mt-1 text-sm text-gray-500">
                    @Localizer[Model.IsRecoveryOnly ? "AccountRecoveryBeforeReplacement" : Model.Method == "totp" ? "EnterAuthenticatorCode" : "ChooseAvailableVerificationMethod"]
                </p>
            </div>
            
            <div class="google-login-body">
                @if (Model.IsMfaEnrollmentReauthentication)
                {
                    <div class="mb-6 rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800"
                         role="status"
                         data-test-id="mfa-reauthentication-notice">
                        @Localizer[Model.MfaReauthenticationNoticeKey]
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="bg-red-50 text-red-700 p-3 rounded text-sm border border-red-200 mb-6" role="alert" data-test-id="mfa-error-summary"></div>
                }

                @if (Model.Method == null)
                {
                    <nav class="flex flex-col gap-3" aria-label="@Localizer["ChooseVerificationMethod"]" data-test-id="mfa-method-selector">
                        @if (Model.TotpMfaEnabled)
                        {
                            <a asp-page="./LoginMfa" asp-route-method="totp" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" asp-route-recoveryPurpose="@Model.RecoveryPurpose"
                               class="btn-google-outline w-full text-center" data-test-id="mfa-select-totp">@Localizer["UseAuthenticatorApp"]</a>
                        }
                        @if (Model.EmailMfaEnabled)
                        {
                            <a asp-page="./LoginMfa" asp-route-method="email" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" asp-route-recoveryPurpose="@Model.RecoveryPurpose"
                               class="btn-google-outline w-full text-center" data-test-id="mfa-select-email">@Localizer["UseEmailCode"]</a>
                        }
                        @if (Model.PasskeyEnabled)
                        {
                            <a asp-page="./LoginMfa" asp-route-method="passkey" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" asp-route-recoveryPurpose="@Model.RecoveryPurpose"
                               class="btn-google-outline w-full text-center" data-test-id="mfa-select-passkey">@Localizer["LoginWithPasskey"]</a>
                        }
                        @if (Model.RecoveryCodesAvailable)
                        {
                            <a asp-page="./LoginMfa" asp-route-method="recovery" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" asp-route-recoveryPurpose="@Model.RecoveryPurpose"
                               class="btn-google-outline w-full text-center" data-test-id="mfa-select-recovery">@Localizer["UseRecoveryCode"]</a>
                        }
                    </nav>
                }
                else if (Model.Method == "passkey")
                {
                    <button type="button" id="passkeyLoginBtn" class="btn-google-blue w-full"
                            data-test-id="mfa-passkey-submit" data-username="@Model.PasskeyUserName"
                            data-return-url="@(Model.ReturnUrl ?? Url.Content("~/"))"
                            data-error-no-passkeys="@Localizer["mfa.errors.noPasskeysRegistered"]"
                            data-error-not-found="@Localizer["mfa.errors.passkeyNotRegistered"]">
                        @Localizer["LoginWithPasskey"]
                    </button>
                }
                else if (Model.Method is "totp" or "recovery")
                {
                    <form method="post" data-account-form>
                        <input type="hidden" asp-for="ReturnUrl" />
                        <input type="hidden" asp-for="RememberMe" />
                        <input type="hidden" asp-for="Method" />
                        @if (Model.Method == "totp")
                        {
                            <input type="hidden" asp-for="Input.RecoveryPurpose" />
                            <div class="form-group">
                                <label asp-for="Input.TotpCode" class="block text-sm font-medium text-gray-700 mb-2">@Localizer["VerificationCode"]</label>
                                <input asp-for="Input.TotpCode" class="input-google text-center text-2xl tracking-widest"
                                       placeholder="000 000" autocomplete="one-time-code" inputmode="numeric"
                                       pattern="[0-9]*" maxlength="6" required autofocus data-test-id="mfa-totp-code" />
                                <span asp-validation-for="Input.TotpCode" class="text-red-600 text-xs mt-1 block" data-test-id="mfa-code-error"></span>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label asp-for="Input.RecoveryCode" class="block text-sm font-medium text-gray-700 mb-2">@Localizer["RecoveryCode"]</label>
                                <input asp-for="Input.RecoveryCode" class="input-google font-mono" autocomplete="off"
                                       placeholder="@Localizer["RecoveryCodePlaceholder"]" required autofocus data-test-id="mfa-recovery-code" />
                                <span asp-validation-for="Input.RecoveryCode" class="text-red-600 text-xs mt-1 block"></span>
                            </div>
                            @if (Model.CanSelectRecoveryEnrollment)
                            {
                                <label asp-for="Input.RecoveryPurpose" class="block text-sm font-medium text-gray-700 mt-4 mb-2">@Localizer["AccountRecoveryPurpose"]</label>
                                <select asp-for="Input.RecoveryPurpose" class="input-google" data-test-id="mfa-recovery-purpose">
                                    <option value="@Web.IdP.Helpers.MfaEnrollmentSession.RecoveryEnrollmentPurpose">@Localizer["AccountRecoveryReplaceVerificationMethod"]</option>
                                    <option value="sign-in">@Localizer["AccountRecoverySignInOnly"]</option>
                                </select>
                            }
                        }
                        <button type="submit" class="btn-google-blue w-full mt-6" data-test-id="mfa-submit">@Localizer["Verify"]</button>
                    </form>
                }

                <p class="mt-6 text-sm text-gray-600" data-test-id="mfa-lost-factor-guidance">@Localizer["AccountRecoveryLostFactorGuidance"]</p>
                <div class="flex flex-col gap-3 mt-6">
                    @if (Model.Method != null)
                    {
                        <a asp-page="./LoginMfa" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe" asp-route-recoveryPurpose="@Model.RecoveryPurpose"
                           class="link-google text-sm" data-test-id="mfa-other-methods">@Localizer["OtherVerificationMethods"]</a>
                    }
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="link-google text-sm font-medium">@Localizer["BackToLogin"]</a>
                </div>
            </div>
        </div>
        
        <partial name="_GoogleFooter" />
    </div>
</body>
</html>
