@page "/Account/PendingDirectorySettlement"
@model Web.IdP.Pages.Account.PendingDirectorySettlementModel
@using Core.Application
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using Web.IdP.Services
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject IViteManifestService ViteService
@inject IBrandingService BrandingService
@{
    ViewData["Title"] = Localizer["PendingSettlement.Title"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
    var productName = await BrandingService.GetProductNameAsync();
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @productName</title>
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    <script type="module" vite-src="src/scripts/pendingDirectorySettlement.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <main class="google-login-container"
          data-pending-directory-settlement
          data-claim-endpoint="/api/account/pending-directory-settlement/claim"
          data-verify-endpoint="/api/account/pending-directory-settlement/verify"
          data-cancel-endpoint="/api/account/pending-directory-settlement/cancel"
          data-message-unavailable="@Localizer["PendingSettlement.Unavailable"]"
          data-message-invalid-code="@Localizer["PendingSettlement.InvalidCode"]"
          data-message-resolved="@Localizer["PendingSettlement.Resolved"]"
          data-message-cancelled="@Localizer["PendingSettlement.Cancelled"]">
        <div class="google-login-card">
            <header class="google-login-header text-center">
                <div class="flex justify-center mb-4">
                    <div class="google-logo" aria-hidden="true">
                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                </div>
                <h1 class="text-2xl font-normal text-gray-900 mb-2">@Localizer["PendingSettlement.Title"]</h1>
            </header>

            <div class="google-login-body min-w-0">
                <div hidden
                     class="mb-6 rounded-md border px-4 py-3 text-sm break-words"
                     role="alert"
                     aria-live="assertive"
                     tabindex="-1"
                     data-pending-settlement-message></div>

                <section data-pending-settlement-claim-step>
                    <p class="mb-2 text-xs font-medium text-blue-600">@Localizer["PendingSettlement.Step1"]</p>
                    <h2 class="text-lg font-normal text-gray-800">@Localizer["PendingSettlement.EnterContinuation"]</h2>

                    <form method="post"
                          action="/api/account/pending-directory-settlement/claim"
                          autocomplete="off"
                          data-pending-settlement-claim-form>
                        <div class="form-group">
                            <label for="pending-settlement-continuation" class="block text-sm font-medium text-gray-700 mb-2">
                                @Localizer["PendingSettlement.Continuation"]
                            </label>
                            <input id="pending-settlement-continuation"
                                   type="text"
                                   class="input-google"
                                   required
                                   maxlength="256"
                                   autocomplete="off"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   placeholder="@Localizer["PendingSettlement.ContinuationPlaceholder"]"
                                   aria-describedby="pending-settlement-continuation-help"
                                   data-pending-settlement-continuation />
                            <p id="pending-settlement-continuation-help" class="mt-2 text-xs text-gray-500 break-words">
                                @Localizer["PendingSettlement.ContinuationHelp"]
                            </p>
                        </div>
                        <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
                            <a asp-page="./Login" class="link-google text-sm font-medium">
                                @Localizer["BackToLogin"]
                            </a>
                            <button type="submit" class="btn-google-blue" data-pending-settlement-claim>
                                @Localizer["PendingSettlement.Continue"]
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                </section>

                <section hidden data-pending-settlement-verify-step>
                    <p class="mb-2 text-xs font-medium text-blue-600">@Localizer["PendingSettlement.Step2"]</p>
                    <h2 class="text-lg font-normal text-gray-800">@Localizer["PendingSettlement.VerifyOwnership"]</h2>
                    <div class="mt-3 mb-6 rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800"
                         role="status">
                        @Localizer["PendingSettlement.CodeSent"]
                    </div>

                    <form method="post"
                          action="/api/account/pending-directory-settlement/verify"
                          autocomplete="off"
                          data-pending-settlement-verify-form>
                        <div class="space-y-4">
                            <div class="form-group">
                                <label for="pending-settlement-code" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["PendingSettlement.OwnershipCode"]
                                </label>
                                <input id="pending-settlement-code"
                                       type="text"
                                       class="input-google text-center text-2xl tracking-widest"
                                       required
                                       inputmode="numeric"
                                       pattern="[0-9]{6}"
                                       maxlength="6"
                                       autocomplete="one-time-code"
                                       aria-describedby="pending-settlement-code-help"
                                       data-pending-settlement-code />
                                <p id="pending-settlement-code-help" class="mt-2 text-xs text-gray-500">
                                    @Localizer["PendingSettlement.OwnershipCodeHelp"]
                                </p>
                            </div>

                            <div class="form-group">
                                <label for="pending-settlement-credential" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["PendingSettlement.CurrentCredential"]
                                </label>
                                <input id="pending-settlement-credential"
                                       type="password"
                                       class="input-google"
                                       required
                                       maxlength="1024"
                                       autocomplete="current-password"
                                       aria-describedby="pending-settlement-credential-help"
                                       data-pending-settlement-credential />
                                <p id="pending-settlement-credential-help" class="mt-2 text-xs text-gray-500 break-words">
                                    @Localizer["PendingSettlement.CurrentCredentialHelp"]
                                </p>
                            </div>
                        </div>

                        <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
                            <button type="button"
                                    class="btn-google-secondary"
                                    data-pending-settlement-cancel>
                                @Localizer["PendingSettlement.Cancel"]
                            </button>
                            <button type="submit" class="btn-google-blue" data-pending-settlement-verify>
                                @Localizer["PendingSettlement.VerifyAndFinish"]
                            </button>
                        </div>
                        <p class="mt-4 text-xs text-gray-500">@Localizer["PendingSettlement.CancelHelp"]</p>
                    </form>
                </section>

                <section hidden data-pending-settlement-result-step>
                    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"
                         role="status"
                         tabindex="-1"
                         data-pending-settlement-result></div>
                    <div class="mt-8 flex justify-end">
                        <a asp-page="./Login" class="btn-google-blue">@Localizer["BackToLogin"]</a>
                    </div>
                </section>
            </div>
        </div>
        <partial name="_GoogleFooter" />
    </main>
</body>
</html>
