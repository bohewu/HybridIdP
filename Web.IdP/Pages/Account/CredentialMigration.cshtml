@page
@model Web.IdP.Pages.Account.CredentialMigrationModel
@using Core.Application
@using Web.IdP.Services
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject IViteManifestService ViteService
@inject IBrandingService BrandingService
@{
    ViewData["Title"] = Localizer["CredentialMigration.Title"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
    var productName = await BrandingService.GetProductNameAsync();
    var stepLabel = Model.AwaitingNewPassword
        ? Localizer["CredentialMigration.Step2"]
        : Localizer["CredentialMigration.Step1"];
    var stepTitle = Model.AwaitingNewPassword
        ? Localizer["CredentialMigration.SetNewPassword"]
        : Model.AwaitingProof
            ? Localizer["CredentialMigration.VerifyRecoveryProof"]
            : Localizer["CredentialMigration.VerifyIdentity"];
    var stepDescription = Model.AwaitingNewPassword
        ? Localizer["CredentialMigration.Step2Description"]
        : Model.AwaitingProof
            ? Localizer["CredentialMigration.ProofDescription"]
            : Localizer["CredentialMigration.Step1Description"];
    var proofMessage = Localizer[$"CredentialMigration.Outcome.{Model.ProofOutcomeCode}"];
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @productName</title>

    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <div class="google-login-container">
        <div class="google-login-card">
            <div class="google-login-header text-center">
                <div class="flex justify-center mb-4">
                    <div class="google-logo">
                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                </div>
                <h1 class="text-2xl font-normal text-gray-900 mb-2">@productName</h1>
                <p class="text-xs font-medium text-blue-600 mb-2">@stepLabel</p>
                <h2 class="text-lg text-gray-700 font-normal">@stepTitle</h2>
                <p class="mt-2 text-sm text-gray-500">@stepDescription</p>
            </div>

            <div class="google-login-body">
                @if (Model.RequestDenied)
                {
                    <div class="bg-red-50 text-red-700 p-3 rounded text-sm border border-red-200 mb-6"
                         role="alert"
                         data-test-id="credential-migration-request-error">
                        @Localizer["CredentialMigration.RequestFailed"]
                    </div>
                }

                @if (Model.AwaitingNewPassword)
                {
                    <form method="post" asp-page-handler="Commit" autocomplete="off">
                        <div class="space-y-4">
                            <div class="form-group">
                                <label asp-for="Commit.NewPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["CredentialMigration.NewPassword"]
                                </label>
                                <input asp-for="Commit.NewPassword"
                                       type="password"
                                       class="input-google"
                                       placeholder="@Localizer["CredentialMigration.NewPassword"]"
                                       autocomplete="new-password"
                                       autofocus
                                       aria-describedby="credential-migration-password-hint"
                                       data-test-id="credential-migration-new-password" />
                                <span asp-validation-for="Commit.NewPassword" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Commit.ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["CredentialMigration.ConfirmPassword"]
                                </label>
                                <input asp-for="Commit.ConfirmPassword"
                                       type="password"
                                       class="input-google"
                                       placeholder="@Localizer["CredentialMigration.ConfirmPassword"]"
                                       autocomplete="new-password"
                                       data-test-id="credential-migration-confirm-password" />
                                <span asp-validation-for="Commit.ConfirmPassword" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <p id="credential-migration-password-hint" class="text-xs text-gray-500 leading-relaxed">
                                @Localizer["CredentialMigration.PasswordPolicyHint"]
                            </p>
                        </div>

                        <div class="flex items-center justify-between mt-8">
                            <a asp-page="./Login" class="link-google text-sm font-medium">
                                @Localizer["BackToLogin"]
                            </a>
                            <button type="submit" class="btn-google-blue ml-4" data-test-id="credential-migration-commit">
                                @Localizer["CredentialMigration.SavePassword"]
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                }
                else if (Model.AwaitingProof)
                {
                    <div data-test-id="credential-migration-proof-state">
                        <div class="bg-blue-50 text-blue-800 p-3 rounded text-sm border border-blue-200 mb-5"
                             role="status"
                             data-test-id="credential-migration-proof-outcome">
                            @proofMessage
                        </div>

                        <form method="post" asp-page-handler="VerifyOtp" autocomplete="off">
                            <div class="form-group">
                                <label asp-for="Proof.Code" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["CredentialMigration.OtpCode"]
                                </label>
                                <input asp-for="Proof.Code"
                                       class="input-google"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       maxlength="8"
                                       placeholder="@Localizer["CredentialMigration.OtpCodePlaceholder"]"
                                       aria-describedby="credential-migration-otp-help"
                                       data-test-id="credential-migration-otp-code" />
                                <span asp-validation-for="Proof.Code" class="text-red-600 text-xs mt-1 block"></span>
                                <p id="credential-migration-otp-help" class="text-xs text-gray-500 mt-2">
                                    @Localizer["CredentialMigration.OtpCodeHelp"]
                                </p>
                            </div>
                            <div class="flex items-center justify-end mt-5">
                                <button type="submit" class="btn-google-blue" data-test-id="credential-migration-verify-otp">
                                    @Localizer["CredentialMigration.VerifyOtp"]
                                </button>
                            </div>
                            @Html.AntiForgeryToken()
                        </form>

                        <div class="border-t border-gray-200 mt-6 pt-5">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                                <p class="text-sm text-gray-600">@Localizer["CredentialMigration.SendOrResendHelp"]</p>
                                <form method="post" asp-page-handler="ResendOtp">
                                    <button type="submit"
                                            class="btn-google-secondary whitespace-nowrap"
                                            data-credential-migration-resend
                                            data-retry-after="@Model.RetryAfterSeconds"
                                            data-ready-label="@Localizer["CredentialMigration.ResendOtp"]"
                                            data-cooldown-label="@Localizer["CredentialMigration.ResendOtpIn"]"
                                            data-test-id="credential-migration-resend-otp">
                                        @Localizer["CredentialMigration.ResendOtp"]
                                    </button>
                                    @Html.AntiForgeryToken()
                                </form>
                            </div>
                        </div>

                        <div class="border-t border-gray-200 mt-6 pt-5 space-y-4">
                            <div>
                                <h3 class="text-sm font-medium text-gray-900">@Localizer["CredentialMigration.AdminAssistanceTitle"]</h3>
                                <p class="text-sm text-gray-500 mt-1">@Localizer["CredentialMigration.AdminAssistanceDescription"]</p>
                            </div>

                            <form method="post" asp-page-handler="VerifyRecoveryEmail" autocomplete="off">
                                <label for="replacement-proof-code" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["CredentialMigration.ReplacementCode"]
                                </label>
                                <div class="flex flex-col sm:flex-row gap-3">
                                    <input id="replacement-proof-code"
                                           name="Proof.Code"
                                           class="input-google"
                                           inputmode="numeric"
                                           autocomplete="one-time-code"
                                           maxlength="8"
                                           placeholder="@Localizer["CredentialMigration.OtpCodePlaceholder"]"
                                           data-test-id="credential-migration-replacement-code" />
                                    <button type="submit" class="btn-google-secondary whitespace-nowrap" data-test-id="credential-migration-verify-replacement">
                                        @Localizer["CredentialMigration.VerifyReplacement"]
                                    </button>
                                </div>
                                <p class="text-xs text-gray-500 mt-2">@Localizer["CredentialMigration.ReplacementCodeHelp"]</p>
                                @Html.AntiForgeryToken()
                            </form>

                            <form method="post" asp-page-handler="CheckApproval">
                                <button type="submit" class="link-google text-sm font-medium" data-test-id="credential-migration-check-approval">
                                    @Localizer["CredentialMigration.CheckApproval"]
                                </button>
                                @Html.AntiForgeryToken()
                            </form>
                        </div>

                        <div class="mt-7">
                            <a asp-page="./Login" class="link-google text-sm font-medium">@Localizer["BackToLogin"]</a>
                        </div>
                    </div>
                }
                else
                {
                    <form method="post" asp-page-handler="Begin" autocomplete="off">
                        <div class="space-y-4">
                            <div class="form-group">
                                <label asp-for="Input.AccountName" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["CredentialMigration.Account"]
                                </label>
                                <input asp-for="Input.AccountName"
                                       class="input-google"
                                       placeholder="@Localizer["CredentialMigration.Account"]"
                                       autocomplete="username"
                                       autocapitalize="none"
                                       spellcheck="false"
                                       autofocus
                                       data-test-id="credential-migration-account" />
                                <span asp-validation-for="Input.AccountName" class="text-red-600 text-xs mt-1 block"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Input.CurrentPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["CredentialMigration.CurrentPassword"]
                                </label>
                                <input asp-for="Input.CurrentPassword"
                                       type="password"
                                       class="input-google"
                                       placeholder="@Localizer["CredentialMigration.CurrentPassword"]"
                                       autocomplete="current-password"
                                       data-test-id="credential-migration-current-password" />
                                <span asp-validation-for="Input.CurrentPassword" class="text-red-600 text-xs mt-1 block"></span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between mt-8">
                            <a asp-page="./Login" class="link-google text-sm font-medium">
                                @Localizer["BackToLogin"]
                            </a>
                            <button type="submit" class="btn-google-blue ml-4" data-test-id="credential-migration-begin">
                                @Localizer["CredentialMigration.VerifyAndContinue"]
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                }
            </div>
        </div>

        <partial name="_GoogleFooter" />
    </div>
</body>
</html>
