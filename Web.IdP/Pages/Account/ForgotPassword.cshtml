@page
@model Web.IdP.Pages.Account.ForgotPasswordModel
@using Core.Application
@using global::Infrastructure.Options
@using Web.IdP.Helpers
@using Web.IdP.Services
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject IViteManifestService ViteService
@inject IBrandingService BrandingService
@inject Microsoft.Extensions.Options.IOptions<ForgotPasswordRecoveryOptions> RecoveryOptions
@inject ILocalizationService LocalizationService
@{
    ViewData["Title"] = Localizer["NativeRecovery.Title"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
    var productName = await BrandingService.GetProductNameAsync();
    var guidance = RecoveryOptions.Value;
    var topNotice = await DynamicLocalizedTextResolver.ResolveAsync(guidance.TopNotice, currentCulture, LocalizationService);
    var phaseTip = await DynamicLocalizedTextResolver.ResolveAsync(
        Model.RecoverySucceeded ? guidance.SuccessReminder :
        Model.AwaitingPassword ? guidance.ResetTip :
        Model.AwaitingCode ? guidance.VerificationTip : null, currentCulture, LocalizationService);
    var phaseTipId = Model.RecoverySucceeded ? "success-reminder" :
        Model.AwaitingPassword ? "reset-tip" : "verification-tip";
    var supportText = await DynamicLocalizedTextResolver.ResolveAsync(guidance.SupportText, currentCulture, LocalizationService);
    var supportLabel = await DynamicLocalizedTextResolver.ResolveAsync(guidance.SupportLabel, currentCulture, LocalizationService);
    var supportUrl = Uri.TryCreate(guidance.SupportUrl, UriKind.Absolute, out var parsedSupportUrl) &&
        (parsedSupportUrl.Scheme == Uri.UriSchemeHttps || parsedSupportUrl.Scheme == Uri.UriSchemeHttp) &&
        string.IsNullOrEmpty(parsedSupportUrl.UserInfo) ? parsedSupportUrl.AbsoluteUri : null;
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @productName</title>
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <main class="google-login-container" data-native-recovery>
        <div class="google-login-card">
            <header class="google-login-header text-center">
                <div class="flex justify-center mb-4">
                    <div class="google-logo" aria-hidden="true">
                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                </div>
                <h1 class="text-2xl font-normal text-gray-900 mb-2">@Localizer["NativeRecovery.Title"]</h1>
                <p class="mt-1 text-sm text-gray-500">@Localizer["NativeRecovery.Description"]</p>
            </header>

            <div class="google-login-body min-w-0">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All"
                         class="bg-red-50 text-red-700 p-3 rounded text-sm border border-red-200 mb-6 break-words"
                         role="alert"
                         data-test-id="native-recovery-error"></div>
                }

                @if (Model.RecoverySucceeded)
                {
                    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 break-words"
                         role="status"
                         tabindex="-1"
                         data-native-recovery-autofocus
                         data-test-id="native-recovery-success">
                        @Localizer["NativeRecovery.Success"]
                    </div>
                }
                else if (Model.AwaitingPassword)
                {
                    <p class="mb-6 text-sm text-gray-600" role="status">
                        @Localizer["NativeRecovery.PasswordPrompt"]
                    </p>
                }
                else if (Model.AwaitingCode)
                {
                    <div class="mb-6 rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800 break-words"
                         role="status"
                         aria-live="polite"
                         data-test-id="native-recovery-sent">
                        @Localizer["NativeRecovery.Sent"]
                    </div>
                }

                @if (topNotice is not null)
                {
                    <p class="my-4 text-sm text-gray-600 break-words" style="overflow-wrap: anywhere;" data-test-id="native-recovery-top-notice">@topNotice</p>
                }
                @if (phaseTip is not null)
                {
                    <p class="my-4 text-sm text-gray-600 break-words" style="overflow-wrap: anywhere;" data-test-id="native-recovery-@phaseTipId">@phaseTip</p>
                }

                @if (Model.RecoverySucceeded)
                {
                    <div class="mt-8 flex justify-end">
                        <a asp-page="./Login" class="btn-google-blue" data-test-id="native-recovery-login">
                            @Localizer["NativeRecovery.SignIn"]
                        </a>
                    </div>
                }
                else if (Model.AwaitingPassword)
                {
                    <form method="post" asp-page-handler="Reset" data-native-recovery-form>
                        <div class="space-y-4">
                            <div class="form-group">
                                <label asp-for="Password.NewPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["NativeRecovery.NewPassword"]
                                </label>
                                <input name="Password.NewPassword"
                                       id="Password_NewPassword"
                                       type="password"
                                       value=""
                                       class="input-google"
                                       placeholder="@Localizer["NativeRecovery.NewPasswordPlaceholder"]"
                                       required
                                       autocomplete="new-password"
                                       aria-describedby="native-recovery-password-help"
                                       data-native-password
                                       data-native-recovery-autofocus
                                       data-test-id="native-recovery-password" />
                            </div>
                            <div class="form-group">
                                <label asp-for="Password.ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                                    @Localizer["NativeRecovery.ConfirmPassword"]
                                </label>
                                <input name="Password.ConfirmPassword"
                                       id="Password_ConfirmPassword"
                                       type="password"
                                       value=""
                                       class="input-google"
                                       placeholder="@Localizer["NativeRecovery.ConfirmPasswordPlaceholder"]"
                                       required
                                       autocomplete="new-password"
                                       data-native-password-confirm
                                       data-test-id="native-recovery-confirm-password" />
                            </div>
                            @if (Model.CurrentPolicy is { } policy)
                            {
                                <div id="native-recovery-password-help"
                                     class="rounded-md border border-gray-200 bg-gray-50 px-3 py-3 text-xs text-gray-600"
                                     data-native-password-policy
                                     data-progress-template="@Localizer["NativeRecovery.Policy.ProgressTemplate"]"
                                     data-test-id="native-recovery-password-policy">
                                    <p class="font-medium text-gray-700">@Localizer["NativeRecovery.Policy.Title"]</p>
                                    <ul class="mt-2 space-y-1">
                                        @foreach (var rule in Model.ClientPasswordRules)
                                        {
                                            <li class="flex items-start gap-2 text-gray-500"
                                                data-native-password-rule="@rule.Name"
                                                data-required-value="@rule.RequiredValue"
                                                data-rule-valid="false">
                                                <span class="w-4 shrink-0 text-center" data-rule-icon aria-hidden="true">○</span>
                                                <span>
                                                    @if (rule.RequiredValue is int requiredValue)
                                                    {
                                                        @Localizer[rule.ResourceKey, requiredValue]
                                                    }
                                                    else
                                                    {
                                                        @Localizer[rule.ResourceKey]
                                                    }
                                                </span>
                                            </li>
                                        }
                                        <li class="flex items-start gap-2 text-gray-500"
                                            data-native-password-rule="confirmation"
                                            data-rule-valid="false">
                                            <span class="w-4 shrink-0 text-center" data-rule-icon aria-hidden="true">○</span>
                                            <span>@Localizer["NativeRecovery.Policy.Confirmation"]</span>
                                        </li>
                                    </ul>
                                    @{ var clientRuleCount = Model.ClientPasswordRules.Count + 1; }
                                    <div class="mt-3" aria-live="polite">
                                        <p data-native-password-progress-text>
                                            @Localizer["NativeRecovery.Policy.Progress", 0, clientRuleCount]
                                        </p>
                                        <progress class="mt-1 h-1.5 w-full accent-blue-600"
                                                  value="0"
                                                  max="@clientRuleCount"
                                                  data-native-password-progress></progress>
                                    </div>
                                    @if (policy.PasswordHistoryCount > 0)
                                    {
                                        <p class="mt-3 text-gray-600">
                                            @Localizer["NativeRecovery.Policy.PasswordReuseServer", policy.PasswordHistoryCount]
                                        </p>
                                    }
                                    <p class="mt-2 text-gray-500">@Localizer["NativeRecovery.Policy.ServerAuthority"]</p>
                                </div>
                            }
                        </div>
                        <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
                            <button type="submit"
                                    formaction="@Url.Page("./ForgotPassword", "StartOver")"
                                    formnovalidate
                                    class="link-google text-sm font-medium">
                                @Localizer["NativeRecovery.StartOver"]
                            </button>
                            <button type="submit" class="btn-google-blue" data-test-id="native-recovery-reset">
                                @Localizer["NativeRecovery.ResetPassword"]
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                }
                else if (Model.AwaitingCode)
                {
                    <form method="post" asp-page-handler="Verify" data-native-recovery-form>
                        <div class="form-group">
                            <label asp-for="Verification.Code" class="block text-sm font-medium text-gray-700 mb-2">
                                @Localizer["NativeRecovery.Code"]
                            </label>
                            <input asp-for="Verification.Code"
                                   class="input-google text-center text-2xl tracking-widest"
                                   placeholder="@Localizer["NativeRecovery.CodePlaceholder"]"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   maxlength="6"
                                   required
                                   aria-describedby="native-recovery-code-help"
                                   data-native-recovery-code
                                   data-native-recovery-autofocus
                                   data-test-id="native-recovery-code" />
                            <p id="native-recovery-code-help" class="mt-2 text-xs text-gray-500 break-words">
                                @Localizer["NativeRecovery.CodeHelp"]
                            </p>
                        </div>
                        <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
                            <button type="submit"
                                    formaction="@Url.Page("./ForgotPassword", "StartOver")"
                                    formnovalidate
                                    class="link-google text-sm font-medium">
                                @Localizer["NativeRecovery.StartOver"]
                            </button>
                            <button type="submit" class="btn-google-blue" data-test-id="native-recovery-verify">
                                @Localizer["NativeRecovery.Verify"]
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Start" data-native-recovery-form>
                        <div class="form-group">
                            <label asp-for="Identifier.Value" class="block text-sm font-medium text-gray-700 mb-2">
                                @Localizer["NativeRecovery.Identifier"]
                            </label>
                            <input asp-for="Identifier.Value"
                                   class="input-google"
                                   autocomplete="username"
                                   required
                                   aria-describedby="native-recovery-identifier-help"
                                   data-native-recovery-autofocus
                                   data-test-id="native-recovery-identifier" />
                            <p id="native-recovery-identifier-help" class="mt-2 text-xs text-gray-500 break-words">
                                @Localizer["NativeRecovery.IdentifierHelp"]
                            </p>
                        </div>
                        <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
                            <a asp-page="./Login" class="link-google text-sm font-medium">
                                @Localizer["BackToLogin"]
                            </a>
                            <button type="submit" class="btn-google-blue" data-test-id="native-recovery-start">
                                @Localizer["NativeRecovery.Continue"]
                            </button>
                        </div>
                        @Html.AntiForgeryToken()
                    </form>
                }
                @if (supportText is not null || (supportUrl is not null && supportLabel is not null))
                {
                    <div class="mt-6 border-t border-gray-200 pt-4 text-sm text-gray-600 break-words" style="overflow-wrap: anywhere;" data-test-id="native-recovery-support">
                        @if (supportText is not null)
                        {
                            <p data-test-id="native-recovery-support-text">@supportText</p>
                        }
                        @if (supportUrl is not null && supportLabel is not null)
                        {
                            <a href="@supportUrl" class="link-google mt-2 inline-block text-sm" data-test-id="native-recovery-support-link">@supportLabel</a>
                        }
                    </div>
                }
            </div>
        </div>
        <partial name="_GoogleFooter" />
    </main>
</body>
</html>
