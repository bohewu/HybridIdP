@page
@model Web.IdP.Pages.Account.ExternalLoginConfirmationModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject Web.IdP.Services.IViteManifestService ViteService
@{
    ViewData["Title"] = Localizer["CompleteLogin"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    @* Tailwind CSS *@
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    
    @* Google Fonts - Roboto for body, will fallback gracefully *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <div class="google-login-container">
        
        <div class="sm:mx-auto sm:w-full sm:max-w-md mt-12">
             <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
                @Localizer["CompleteLogin"]
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                @Localizer["AuthenticateWith"] <strong>@Model.LoginProvider</strong>
            </p>
             <p class="text-center text-xs text-gray-500">
                (@Model.Email)
            </p>
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-2xl">
            <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
                
                <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>

                <div class="grid grid-cols-1 @(Model.ShowRegistrationButton ? "md:grid-cols-2 divide-y md:divide-y-0 md:divide-x" : "") gap-8 divide-gray-200">
                    
                    @* LEFT: Link Existing *@
                    <div class="@(Model.ShowRegistrationButton ? "pr-0 md:pr-4" : "")">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">@Localizer["LinkExistingAccount"]</h3>
                        <p class="text-sm text-gray-500 mb-4">@Localizer["LinkExistingAccountDesc"]</p>
                        
                        <form asp-page-handler="Link" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
                            <div class="form-group">
                                <label asp-for="Input.Login" class="sr-only">@Localizer["EmailOrUsername"]</label>
                                <input asp-for="Input.Login" class="input-google" placeholder="@Localizer["EmailOrUsername"]" />
                                <span asp-validation-for="Input.Login" class="text-red-600 text-xs mt-1 block"></span>
                            </div>
                             <div class="form-group">
                                <label asp-for="Input.Password" class="sr-only">@Localizer["Password"]</label>
                                <input asp-for="Input.Password" type="password" class="input-google" placeholder="@Localizer["Password"]" />
                                <span asp-validation-for="Input.Password" class="text-red-600 text-xs mt-1 block"></span>
                            </div>
                            <button type="submit" class="btn-google-blue w-full justify-center">
                                @Localizer["LinkAccount"]
                            </button>
                        </form>
                    </div>

                    @* RIGHT: Create New *@
                    @if (Model.ShowRegistrationButton)
                    {
                        <div class="pt-8 md:pt-0 pl-0 md:pl-4 flex flex-col justify-center">
                            <h3 class="text-lg font-medium text-gray-900 mb-4">@Localizer["CreateNewAccount"]</h3>
                            <p class="text-sm text-gray-500 mb-6">@Localizer["CreateNewAccountDesc", Model.LoginProvider]</p>
                             <form asp-page-handler="Create" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <button type="submit" class="btn-google-white w-full justify-center">
                                    @Localizer["CreateAccount"]
                                </button>
                            </form>
                        </div>
                    }

                </div>
            </div>
        </div>

        <partial name="_GoogleFooter" />
    </div>
</body>
</html>
