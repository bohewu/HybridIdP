@page
@model Web.IdP.Pages.Account.ExternalLoginConfirmationModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Web.IdP.SharedResource> Localizer
@inject Web.IdP.Services.IViteManifestService ViteService
@{
    ViewData["Title"] = Localizer["ExternalLoginConfirmationTitle"];
    Layout = null;
    var currentCulture = HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
}

<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    @* Tailwind CSS *@
    @if (ViteService.IsDevelopment)
    {
        <script type="module" vite-src="@@vite/client"></script>
    }
    <link href="@ViteService.GetScriptPath("src/styles/main.css")" rel="stylesheet" />
    <script type="module" vite-src="src/scripts/razor.js"></script>
    
    @* Google Fonts - Roboto for body, will fallback gracefully *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 google-font min-h-screen flex flex-col">
    <div class="google-login-container">
        @{
            var isWide = Model.ShowRegistrationButton;
            var widthClass = isWide ? "max-w-3xl" : "max-w-[450px]";
            var notices = Model.LoginNotices;
        }

        <div class="sm:mx-auto @widthClass w-full mt-12 mb-8 text-center">
             <div class="flex justify-center mb-4">
                <div class="google-logo mx-auto">
                    @if (Model.LoginProvider == "Google")
                    {
                        <img src="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png" class="w-full h-full" alt="Google" />
                    }
                    else if (Model.LoginProvider == "Microsoft")
                    {
                        <img src="https://www.microsoft.com/favicon.ico" class="w-full h-full" alt="Microsoft" />
                    }
                    else
                    {
                        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                    }
                </div>
            </div>
             <h2 class="text-2xl font-normal text-gray-900 mb-2">
                @Localizer["ExternalLoginConfirmationTitle"]
            </h2>
            <p class="mt-1 text-sm text-gray-500">
                @Localizer["ExternalLoginConfirmationDesc", Model.LoginProvider]
            </p>
             <p class="text-xs text-gray-400 mt-1">
                (@Model.Email)
            </p>
        </div>

        <div class="google-login-card @(isWide ? "wide-card" : "") w-full mx-auto">
            <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>

            @if (!string.IsNullOrWhiteSpace(notices.FormMessage))
            {
                <div class="mb-4">
                     <partial name="_LoginNotice" model="(notices.FormMessage, notices.FormType)" />
                </div>
            }

            <div class="grid grid-cols-1 @(isWide ? "md:grid-cols-2 divide-y md:divide-y-0 md:divide-x" : "") gap-8 divide-gray-100">
                
                @* LEFT: Link Existing *@
                <div class="@(isWide ? "pr-0 md:pr-4" : "")">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">@Localizer["LinkExistingAccount"]</h3>
                    <p class="text-sm text-gray-500 mb-6">@Localizer["LinkExistingAccountDesc", Model.AppName]</p>
                    
                    <form asp-page-handler="Link" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
                        <div class="form-group">
                            <label asp-for="Input.Login" class="sr-only">@Localizer["EmailOrUsername"]</label>
                            <input asp-for="Input.Login" class="input-google" placeholder="@Localizer["EmailOrUsername"]" />
                            <span asp-validation-for="Input.Login" class="text-red-600 text-xs mt-1 block"></span>
                        </div>
                         <div class="form-group">
                            <label asp-for="Input.Password" class="sr-only">@Localizer["Password"]</label>
                            <input asp-for="Input.Password" type="password" class="input-google" placeholder="@Localizer["Password"]" />
                            <span asp-validation-for="Input.Password" class="text-red-600 text-xs mt-1 block"></span>
                        </div>
                        <button type="submit" class="btn-google-blue w-full justify-center">
                            @Localizer["LinkAccount"]
                        </button>
                    </form>
                </div>

                @* RIGHT: Create New *@
                @if (isWide)
                {
                    <div class="pt-8 md:pt-0 pl-0 md:pl-4 flex flex-col justify-center">
                        <h3 class="text-lg font-medium text-gray-900 mb-4">@Localizer["CreateNewAccount"]</h3>
                        <p class="text-sm text-gray-500 mb-6">@Localizer["CreateNewAccountDesc", Model.LoginProvider]</p>
                         <form asp-page-handler="Create" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <button type="submit" class="btn-google-white w-full justify-center">
                                @Localizer["CreateAccount"]
                            </button>
                        </form>
                    </div>
                }

            </div>
            
            @* Bottom Notice - After content *@
            @if (!string.IsNullOrWhiteSpace(notices.BottomMessage))
            {
                <div class="mt-6">
                    <partial name="_LoginNotice" model="(notices.BottomMessage, notices.BottomType)" />
                </div>
            }
        </div>

        <div class="@widthClass w-full mx-auto google-footer-wrapper">
            <partial name="_GoogleFooter" />
        </div>
    </div>
</body>
</html>
