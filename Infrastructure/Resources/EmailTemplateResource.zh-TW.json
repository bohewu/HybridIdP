{
  "MfaCode_Subject": "您的驗證碼 - {ProductName}",
  "MfaCode_Body": "<!doctype html>\n<html lang=\"zh-TW\">\n<body style=\"margin:0;padding:0;background:#f5f7fb;font-family:'Segoe UI','Microsoft JhengHei',Arial,sans-serif;color:#172033;\">\n  <div style=\"display:none;max-height:0;overflow:hidden;opacity:0;\">使用驗證碼 {Code} 完成登入。驗證碼將於 {ExpiryMinutes} 分鐘後失效。</div>\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:#f5f7fb;padding:32px 12px;\">\n    <tr><td align=\"center\">\n      <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:560px;background:#ffffff;border:1px solid #dfe4ec;border-radius:12px;\">\n        <tr><td style=\"padding:32px 36px 12px;font-size:15px;font-weight:600;color:#1a56db;\">{ProductName}</td></tr>\n        <tr><td style=\"padding:8px 36px 0;\"><h1 style=\"margin:0;font-size:24px;line-height:1.35;font-weight:650;color:#172033;\">您的登入驗證碼</h1></td></tr>\n        <tr><td style=\"padding:10px 36px 0;font-size:15px;line-height:1.6;color:#566176;\">請輸入以下驗證碼以完成登入。</td></tr>\n        <tr><td style=\"padding:24px 36px;\"><div style=\"padding:20px 16px;text-align:center;background:#eef4ff;border:1px solid #cbdcff;border-radius:10px;font-family:Consolas,'Courier New',monospace;font-size:34px;line-height:1.2;letter-spacing:8px;font-weight:700;color:#174ea6;\">{Code}</div></td></tr>\n        <tr><td style=\"padding:0 36px 12px;font-size:14px;line-height:1.6;color:#566176;\">此驗證碼將於 <strong>{ExpiryMinutes} 分鐘後</strong>失效。</td></tr>\n        <tr><td style=\"padding:0 36px 32px;font-size:13px;line-height:1.6;color:#758095;\">如果您未要求此驗證碼，請直接忽略這封郵件，且不要將驗證碼提供給任何人。</td></tr>\n      </table>\n      {Footer}\n    </td></tr>\n  </table>\n</body>\n</html>",
  "Email_Footer": "<div style=\"padding:20px 12px 0;text-align:center;font-size:12px;line-height:1.6;color:#8892a5;\">{ProductName}<br>{Copyright}</div>"
}
