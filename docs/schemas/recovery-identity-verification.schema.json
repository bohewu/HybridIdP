{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery Identity Verification Contract 1.0",
  "description": "Validate an endpoint request against #/$defs/request and a response against #/$defs/response.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerNamespace",
        "stableSubject",
        "scheme"
      ],
      "properties": {
        "providerNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        "stableSubject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        "scheme": {
          "type": "string",
          "const": "identity-identifier"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "providerNamespace",
        "stableSubject",
        "scheme",
        "evidence"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "providerNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        "stableSubject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "not": {
            "pattern": "[\\u0000-\\u001F\\u007F]"
          }
        },
        "scheme": {
          "type": "string",
          "const": "identity-identifier"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identityIdentifier"
          ],
          "properties": {
            "identityIdentifier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": {
                "pattern": "[\\u0000-\\u001F\\u007F]"
              }
            }
          }
        }
      }
    },
    "verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "outcome",
        "binding"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "outcome": {
          "const": "Verified"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "notVerified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "outcome"
      ],
      "properties": {
        "contractVersion": {
          "type": "string",
          "const": "1.0"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "Denied",
            "Unavailable",
            "Unsupported",
            "Malformed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requestId": {
                "type": "null"
              }
            },
            "required": [
              "requestId"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "Malformed"
              }
            }
          }
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "$ref": "#/$defs/verified"
        },
        {
          "$ref": "#/$defs/notVerified"
        }
      ]
    }
  }
}
