{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile neutral-query 2.0",
  "description": "Root validates responses; #/$defs/request validates requests. Semantic and authority rules are in NEUTRAL_QUERY_CONTRACT.md.",
  "$comment": "No mixed legacy/v2 shape acceptance.",
  "$ref": "#/$defs/response",
  "$defs": {
    "request": {
      "allOf": [
        {
          "$ref": "../../neutral-query/v2.0/common.schema.json#/$defs/request"
        },
        {
          "type": "object",
          "properties": {
            "contractType": {
              "const": "profile"
            }
          },
          "required": []
        }
      ],
      "unevaluatedProperties": false
    },
    "response": {
      "allOf": [
        {
          "$ref": "../../neutral-query/v2.0/common.schema.json#/$defs/response"
        },
        {
          "type": "object",
          "properties": {
            "contractType": {
              "const": "profile"
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "extraProperties"
              ],
              "properties": {
                "extraProperties": {
                  "$ref": "../v1.0/response.schema.json#/properties/extraProperties"
                }
              }
            }
          },
          "required": []
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
