# Database Configuration
# Valid options: SqlServer, PostgreSQL
DATABASE_PROVIDER=SqlServer
# SQL Server Connection String
CONNECTIONSTRINGS__SQLSERVERCONNECTION="Server=host.docker.internal,1433;Database=hybridauth_idp;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;Encrypt=False"
# PostgreSQL Connection String
CONNECTIONSTRINGS__POSTGRESQLCONNECTION="Host=host.docker.internal;Port=5432;Database=hybridauth_idp;Username=user;Password=password"

# Redis Configuration
REDIS__ENABLED=true
REDIS__CONNECTIONSTRING=host.docker.internal:6379,abortConnect=false

# Legacy Auth API
LEGACYAUTH__LOGINURL="http://host.docker.internal:5299/api/authenticate/login"

# Security
SECURITY__REGISTRATIONENABLED=false

# External Login Configuration
# Google
EXTERNAL_LOGIN__GOOGLE__ENABLED=false
EXTERNAL_LOGIN__GOOGLE__CLIENT_ID=
EXTERNAL_LOGIN__GOOGLE__CLIENT_SECRET=
# Microsoft 365
EXTERNAL_LOGIN__MICROSOFT__ENABLED=false
EXTERNAL_LOGIN__MICROSOFT__CLIENT_ID=
EXTERNAL_LOGIN__MICROSOFT__CLIENT_SECRET=

# Optional external layout assets (http/https only)
# LayoutAssets__ExternalCssLinks__0=https://cdn.example.com/custom.css
# LayoutAssets__ExternalJsLinks__0=https://cdn.example.com/custom.js
# LayoutAssets__ExternalScriptTags__0__Src=https://cdn.example.com/external/loader.min.js
# LayoutAssets__ExternalScriptTags__0__DataAttributes__0__Name=data-mount-ids
# LayoutAssets__ExternalScriptTags__0__DataAttributes__0__Value=container, app
# LayoutAssets__ExternalScriptTags__0__DataAttributes__1__Name=data-core-path
# LayoutAssets__ExternalScriptTags__0__DataAttributes__1__Value=https://cdn.example.com/external/runtime.min.js

# Optional CSP source extensions
# SecurityHeaders__Csp__ScriptSrc__0=https://cdn.example.com
# SecurityHeaders__Csp__StyleSrc__0=https://cdn.example.com
# SecurityHeaders__Csp__FontSrc__0=https://cdn.example.com
# SecurityHeaders__Csp__FontSrcElem__0=https://fonts.example.com
# SecurityHeaders__Csp__ConnectSrc__0=https://api.example.com
# SecurityHeaders__Csp__FrameSrc__0=https://widgets.example.com
# SecurityHeaders__Csp__AdditionalDirectives__0=upgrade-insecure-requests
# SecurityHeaders__Csp__AdditionalDirectives__1=worker-src 'self' blob:
